<!-- Barra superior -->
<header class="fixed top-0 left-0 w-full z-50 flex justify-between items-center px-4 md:px-margin h-16 bg-surface">
  <div class="flex items-center gap-sm">
    <div class="icon-circle w-10 h-10 bg-surface-variant text-on-surface-variant overflow-hidden cursor-pointer transition-transform active:scale-90">
      <span class="material-symbols-outlined">person</span>
    </div>
    <span class="text-headline-md font-bold text-secondary">moneyFlow</span>
  </div>
  <button class="material-symbols-outlined text-primary p-2 rounded-full hover:opacity-80 transition-opacity active:scale-90" type="button" aria-label="Notificações">notifications</button>
</header>

<main class="mt-20 pb-32 px-4 md:px-margin max-w-[1280px] mx-auto">
  <section class="mb-8">
    <div>
      <span class="mb-2 text-label-lg text-on-surface" >Olá <span class="text-secondary"> <%= @usuario['usu_nome'] %> </span>, <br> Seja bem vindo de voltar! </span>
    </div>
  </section>
  <!-- Saldo total -->
  <section class="mb-lg">
    <div class="card relative overflow-hidden group">
      <div class="absolute -right-12 -top-12 w-48 h-48 bg-secondary/10 rounded-full blur-3xl group-hover:bg-secondary/20 transition-all duration-500"></div>
      <p class="text-label-lg text-on-surface-variant mb-xs">Saldo Total</p>
      <h1 class="text-number-display text-secondary"><%= moeda(@saldo["saldo"]) %></h1>
      <% positivo = !@resumo["saldo"].to_f.negative? %>
      <div class="mt-sm flex items-center gap-xs <%= positivo ? "text-primary-container" : "text-tertiary" %>">
        <span class="material-symbols-outlined text-sm"><%= positivo ? "trending_up" : "trending_down" %></span>
        <span class="text-label-md"><%= moeda(@resumo["saldo"]) %> este mês</span>
      </div>
    </div>
  </section>

  <!-- Resumo rápido (receitas x despesas) -->
  <section class="grid grid-cols-2 gap-gutter mb-lg">
    <div class="card shadow-lift">
      <div class="flex items-center gap-sm mb-base">
        <div class="icon-circle w-8 h-8 bg-primary-container/20 text-primary-container">
          <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
        </div>
        <span class="text-label-lg text-on-surface-variant">Receitas</span>
      </div>
      <p class="text-headline-md text-primary-container"><%= moeda(@resumo["receitas"]) %></p>
    </div>
    <div class="card shadow-lift">
      <div class="flex items-center gap-sm mb-base">
        <div class="icon-circle w-8 h-8 bg-tertiary-container/20 text-tertiary">
          <span class="material-symbols-outlined text-[18px]">arrow_upward</span>
        </div>
        <span class="text-label-lg text-on-surface-variant">Despesas</span>
      </div>
      <p class="text-headline-md text-tertiary"><%= moeda(@resumo["despesas"]) %></p>
    </div>
  </section>

  <!-- Fluxo de caixa (gráfico de barras simples) -->
  <section class="mb-lg">
    <div class="card">
      <div class="flex justify-between items-center mb-md">
        <h2 class="text-headline-md text-on-surface">Fluxo de Caixa</h2>
        <span class="text-label-md text-on-surface-variant bg-surface-container px-sm py-xs rounded-full">Últimos 7 dias</span>
      </div>
      <div class="flex items-end justify-between h-40 gap-xs">
        <% @fluxo.each do |dia| %>
          <div class="chart-bar min-h-1" data-altura="<%= dia[:altura] %>" style="height: 0%">
            <span class="chart-bar-label whitespace-nowrap"><%= dia[:rotulo] %> · <%= moeda(dia[:valor]) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Últimas transações -->
  <section>
    <div class="flex justify-between items-center gap-sm mb-md">
      <h3 class="text-headline-md text-on-surface">Transações Recentes</h3>
      <button class="link-accent text-label-lg" type="button"><a href="/movimentacoes">Ver Todos</a></button>
    </div>

    <div class="flex flex-col gap-gutter">
      <% if !@receitas.empty? %>
        <% @receitas.first(5).each do |r| %>
          <div class="card p-4 sm:p-md shadow-lift flex items-center justify-between gap-sm cursor-pointer">
            <div class="flex items-center gap-3 sm:gap-4 min-w-0">
              <div class="icon-circle w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 text-primary shrink-0">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;"><%= r["car_nome"] ? "credit_card" : "payments" %></span>
              </div>
             <div class="min-w-0">
                <p class="text-label-lg text-on-surface truncate">
                  <%= r["mov_nome"] %>
                  <% if !parcela_de(r).empty? %>
                    <span class="text-label-md text-outline">(<%= parcela_de(r) %>)</span>
                  <% end %>
                </p>
                <p class="text-label-md text-outline"> <%= r["mov_data"] %> </p>
              </div>
            </div>
           <div class="text-right shrink-0">
            <p class="text-body-lg font-bold sm:text-headline-md <%= r["mov_tipo"] == "RECEITA" ? "text-primary" : "text-tertiary" %> whitespace-nowrap">
              <%= r["mov_tipo"] == "RECEITA" ? "+" : "-" %> <%= moeda(r["mov_valor"]) %>
              </p>
               <span class="text-label-md text-outline gap-x-[1]">
                  <%= r["con_nome"] || r["car_nome"] %>
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-surface-container-high text-on-surface-variant">
                     <%= r["cat_nome"] %>
                  </span>
               </span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center justify-center text-center gap-base py-xl px-md rounded-xl border-2 border-dashed border-outline-variant/50 bg-surface-container-low/40">
          <div class="icon-circle w-20 h-20 bg-primary-container/20 mb-sm">
            <span class="material-symbols-outlined text-primary text-[40px]">savings</span>
          </div>
          <h4 class="text-headline-md text-on-surface">Nenhuma receita por aqui ainda</h4>
          <p class="text-body-md text-on-surface-variant max-w-[360px]">
            Parece que você não lançou nenhuma entrada... Clique no botão abaixo para registrar a sua primeira receita!
          </p>
          <a class="mt-sm py-4 px-6 bg-secondary text-white text-label-lg rounded-xl flex items-center justify-center gap-2 shadow-lift active:scale-[0.98]" href="/movimentacoes/cadastrar">
            <span class="material-symbols-outlined">add_circle</span>
            Adicionar Receita
          </a>
        </div>
      <% end %>
    </div>
  </section>
</main>
<!-- Botão flutuante de nova transação -->
<a class="fixed bottom-24 right-6 w-14 h-14 bg-secondary-container text-on-secondary-container rounded-full shadow-lg flex items-center justify-center transition-transform active:scale-90 z-40" href="/movimentacoes/cadastrar" aria-label="Adicionar Receita">
  <span class="material-symbols-outlined text-[32px]">add</span>
</a>


<script>
  // Animação de entrada das barras: começam em 0% e crescem até a altura
  // que veio do banco em data-altura
  window.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.chart-bar').forEach((barra, i) => {
      setTimeout(() => {
        barra.style.transition = 'height 0.8s cubic-bezier(0.34, 1.56, 0.64, 1)';
        barra.style.height = barra.dataset.altura + '%';
      }, 100 + i * 100);
    });
  });
</script>
