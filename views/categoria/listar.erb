<!-- Barra superior -->
<header class="fixed top-0 left-0 w-full z-50 flex justify-between items-center px-4 md:px-margin h-16 bg-surface">
  <div class="flex items-center gap-sm">
    <div class="icon-circle w-10 h-10 bg-surface-variant text-on-surface-variant overflow-hidden cursor-pointer transition-transform active:scale-90">
      <span class="material-symbols-outlined">person</span>
    </div>
    <span class="text-headline-md font-bold text-secondary">moneyFlow</span>
  </div>
  <button class="material-symbols-outlined text-primary p-2 rounded-full hover:opacity-80 transition-opacity active:scale-90" type="button" aria-label="Notificações">notifications</button>
</header>

<main class="mt-20 pb-32 px-4 md:px-margin max-w-[1280px] mx-auto">
  <!-- Título -->
  <div class="mb-lg">
    <p class="text-label-lg text-secondary uppercase tracking-widest">Organização</p>
    <h2 class="text-headline-lg text-on-surface mb-2">Gerenciar Categorias</h2>
    <p class="text-body-md text-on-surface-variant">Organize suas finanças com categorias personalizadas.</p>
  </div>

  <!-- Abas + busca (no desktop ficam lado a lado) -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-md mb-md">
    <div class="flex gap-lg border-b border-outline-variant">
      <button class="tab-categoria is-selected" data-aba="DESPESA" type="button">Despesas</button>
      <button class="tab-categoria" data-aba="RECEITA" type="button">Receitas</button>
    </div>
    <div class="relative flex-1 md:max-w-[448px]">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
      <input class="w-full pl-10 pr-4 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md text-on-surface placeholder:text-outline-variant transition-all focus:outline-none focus:border-secondary" id="busca" placeholder="Buscar categorias..." type="text">
    </div>
  </div>

  <!-- Grade de categorias. Cada card carrega data-tipo (a aba filtra por ele)
       e data-nome (a busca filtra por ele). -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-gutter" id="grade-categorias">
    <!-- ===== Despesas ===== -->
    <div class="card shadow-lift flex items-start justify-between gap-sm cursor-pointer" data-tipo="DESPESA" data-nome="Alimentação">
      <div class="flex items-center gap-md min-w-0">
        <div class="w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-orange-600 shrink-0">
          <span class="material-symbols-outlined">restaurant</span>
        </div>
        <div class="min-w-0">
          <h3 class="text-body-lg font-semibold text-on-surface truncate">Alimentação</h3>
          <span class="inline-block px-2 py-0.5 mt-1 bg-primary-container/10 text-primary-container text-label-md rounded-full whitespace-nowrap">Orçamento: R$ 500/mês</span>
          <p class="text-label-md text-on-surface-variant mt-1">24 transações</p>
        </div>
      </div>
      <button class="material-symbols-outlined text-outline hover:text-secondary transition-colors shrink-0" type="button" aria-label="Opções">more_vert</button>
    </div>

    <div class="card shadow-lift flex items-start justify-between gap-sm cursor-pointer" data-tipo="DESPESA" data-nome="Transporte">
      <div class="flex items-center gap-md min-w-0">
        <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-blue-600 shrink-0">
          <span class="material-symbols-outlined">commute</span>
        </div>
        <div class="min-w-0">
          <h3 class="text-body-lg font-semibold text-on-surface truncate">Transporte</h3>
          <span class="inline-block px-2 py-0.5 mt-1 bg-primary-container/10 text-primary-container text-label-md rounded-full whitespace-nowrap">Orçamento: R$ 150/mês</span>
          <p class="text-label-md text-on-surface-variant mt-1">12 transações</p>
        </div>
      </div>
      <button class="material-symbols-outlined text-outline hover:text-secondary transition-colors shrink-0" type="button" aria-label="Opções">more_vert</button>
    </div>

    <div class="card shadow-lift flex items-start justify-between gap-sm cursor-pointer" data-tipo="DESPESA" data-nome="Moradia">
      <div class="flex items-center gap-md min-w-0">
        <div class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-purple-600 shrink-0">
          <span class="material-symbols-outlined">home</span>
        </div>
        <div class="min-w-0">
          <h3 class="text-body-lg font-semibold text-on-surface truncate">Moradia</h3>
          <span class="inline-block px-2 py-0.5 mt-1 bg-primary-container/10 text-primary-container text-label-md rounded-full whitespace-nowrap">Fixo: R$ 1.200</span>
          <p class="text-label-md text-on-surface-variant mt-1">3 transações</p>
        </div>
      </div>
      <button class="material-symbols-outlined text-outline hover:text-secondary transition-colors shrink-0" type="button" aria-label="Opções">more_vert</button>
    </div>

    <div class="card shadow-lift flex items-start justify-between gap-sm cursor-pointer" data-tipo="DESPESA" data-nome="Saúde">
      <div class="flex items-center gap-md min-w-0">
        <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center text-red-600 shrink-0">
          <span class="material-symbols-outlined">medical_services</span>
        </div>
        <div class="min-w-0">
          <h3 class="text-body-lg font-semibold text-on-surface truncate">Saúde</h3>
          <span class="inline-block px-2 py-0.5 mt-1 bg-tertiary-container/20 text-tertiary text-label-md rounded-full whitespace-nowrap">Orçamento: R$ 100/mês</span>
          <p class="text-label-md text-on-surface-variant mt-1">1 transação</p>
        </div>
      </div>
      <button class="material-symbols-outlined text-outline hover:text-secondary transition-colors shrink-0" type="button" aria-label="Opções">more_vert</button>
    </div>

    <div class="card shadow-lift flex items-start justify-between gap-sm cursor-pointer" data-tipo="DESPESA" data-nome="Lazer">
      <div class="flex items-center gap-md min-w-0">
        <div class="w-12 h-12 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-600 shrink-0">
          <span class="material-symbols-outlined">movie</span>
        </div>
        <div class="min-w-0">
          <h3 class="text-body-lg font-semibold text-on-surface truncate">Lazer</h3>
          <span class="inline-block px-2 py-0.5 mt-1 bg-primary-container/10 text-primary-container text-label-md rounded-full whitespace-nowrap">Orçamento: R$ 80/mês</span>
          <p class="text-label-md text-on-surface-variant mt-1">8 transações</p>
        </div>
      </div>
      <button class="material-symbols-outlined text-outline hover:text-secondary transition-colors shrink-0" type="button" aria-label="Opções">more_vert</button>
    </div>

    <div class="card shadow-lift flex items-start justify-between gap-sm cursor-pointer" data-tipo="DESPESA" data-nome="Compras">
      <div class="flex items-center gap-md min-w-0">
        <div class="w-12 h-12 rounded-xl bg-yellow-100 flex items-center justify-center text-yellow-600 shrink-0">
          <span class="material-symbols-outlined">shopping_bag</span>
        </div>
        <div class="min-w-0">
          <h3 class="text-body-lg font-semibold text-on-surface truncate">Compras</h3>
          <span class="inline-block px-2 py-0.5 mt-1 bg-primary-container/10 text-primary-container text-label-md rounded-full whitespace-nowrap">Orçamento: R$ 200/mês</span>
          <p class="text-label-md text-on-surface-variant mt-1">15 transações</p>
        </div>
      </div>
      <button class="material-symbols-outlined text-outline hover:text-secondary transition-colors shrink-0" type="button" aria-label="Opções">more_vert</button>
    </div>

    <!-- ===== Receitas (escondidas até clicar na aba) ===== -->
    <div class="card shadow-lift flex items-start justify-between gap-sm cursor-pointer hidden" data-tipo="RECEITA" data-nome="Salário">
      <div class="flex items-center gap-md min-w-0">
        <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-green-600 shrink-0">
          <span class="material-symbols-outlined">payments</span>
        </div>
        <div class="min-w-0">
          <h3 class="text-body-lg font-semibold text-on-surface truncate">Salário</h3>
          <span class="inline-block px-2 py-0.5 mt-1 bg-primary-container/10 text-primary-container text-label-md rounded-full whitespace-nowrap">Próximo: dia 28</span>
          <p class="text-label-md text-on-surface-variant mt-1">Mensal</p>
        </div>
      </div>
      <button class="material-symbols-outlined text-outline hover:text-secondary transition-colors shrink-0" type="button" aria-label="Opções">more_vert</button>
    </div>

    <div class="card shadow-lift flex items-start justify-between gap-sm cursor-pointer hidden" data-tipo="RECEITA" data-nome="Investimentos">
      <div class="flex items-center gap-md min-w-0">
        <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center text-teal-600 shrink-0">
          <span class="material-symbols-outlined">monitoring</span>
        </div>
        <div class="min-w-0">
          <h3 class="text-body-lg font-semibold text-on-surface truncate">Investimentos</h3>
          <span class="inline-block px-2 py-0.5 mt-1 bg-primary-container/10 text-primary-container text-label-md rounded-full whitespace-nowrap">+4,5% no ano</span>
          <p class="text-label-md text-on-surface-variant mt-1">Dividendos</p>
        </div>
      </div>
      <button class="material-symbols-outlined text-outline hover:text-secondary transition-colors shrink-0" type="button" aria-label="Opções">more_vert</button>
    </div>

    <div class="card shadow-lift flex items-start justify-between gap-sm cursor-pointer hidden" data-tipo="RECEITA" data-nome="Freelance">
      <div class="flex items-center gap-md min-w-0">
        <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
          <span class="material-symbols-outlined">laptop_mac</span>
        </div>
        <div class="min-w-0">
          <h3 class="text-body-lg font-semibold text-on-surface truncate">Freelance</h3>
          <span class="inline-block px-2 py-0.5 mt-1 bg-primary-container/10 text-primary-container text-label-md rounded-full whitespace-nowrap">Variável</span>
          <p class="text-label-md text-on-surface-variant mt-1">6 transações</p>
        </div>
      </div>
      <button class="material-symbols-outlined text-outline hover:text-secondary transition-colors shrink-0" type="button" aria-label="Opções">more_vert</button>
    </div>
  </div>

  <!-- Aparece quando a busca não encontra nada na aba atual -->
  <div class="hidden flex-col items-center justify-center text-center gap-base py-xl px-md rounded-xl border-2 border-dashed border-outline-variant/50 bg-surface-container-low/40" id="sem-resultado">
    <div class="icon-circle w-20 h-20 bg-secondary-container/40 mb-sm">
      <span class="material-symbols-outlined text-secondary text-[40px]">search_off</span>
    </div>
    <h4 class="text-headline-md text-on-surface">Nenhuma categoria encontrada</h4>
    <p class="text-body-md text-on-surface-variant max-w-[360px]">Tente outro termo de busca ou troque de aba.</p>
  </div>
</main>

<!-- Botão flutuante de nova categoria -->
<a class="fixed bottom-24 right-6 md:right-12 w-14 h-14 bg-secondary text-on-secondary rounded-full flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition-all z-40 group" href="/categorias/cadastrar" aria-label="Adicionar Categoria">
  <span class="material-symbols-outlined text-3xl group-hover:rotate-90 transition-transform duration-300">add</span>
</a>

<script>
  // ===== Abas + busca =====
  // A aba escolhe o data-tipo e a busca filtra pelo data-nome; as duas
  // condições são aplicadas juntas na mesma passada pelos cards.
  const abas = document.querySelectorAll('.tab-categoria');
  const cards = document.querySelectorAll('#grade-categorias [data-tipo]');
  const busca = document.getElementById('busca');
  const semResultado = document.getElementById('sem-resultado');
  let abaAtual = 'DESPESA';

  function filtrar() {
    const termo = busca.value.trim().toLowerCase();
    let visiveis = 0;

    cards.forEach(card => {
      const mesmoTipo = card.dataset.tipo === abaAtual;
      const combina = card.dataset.nome.toLowerCase().includes(termo);
      const mostrar = mesmoTipo && combina;

      card.classList.toggle('hidden', !mostrar);
      if (mostrar) visiveis++;
    });

    // o estado vazio usa flex, então não dá pra alternar só o 'hidden'
    semResultado.classList.toggle('hidden', visiveis > 0);
    semResultado.classList.toggle('flex', visiveis === 0);
  }

  abas.forEach(aba => {
    aba.addEventListener('click', () => {
      abas.forEach(a => a.classList.remove('is-selected'));
      aba.classList.add('is-selected');
      abaAtual = aba.dataset.aba;
      filtrar();
    });
  });

  busca.addEventListener('input', filtrar);
</script>
