<!-- Barra superior com botão de voltar -->
<header class="fixed top-0 left-0 w-full z-50 flex justify-between items-center px-4 md:px-margin h-16 bg-surface">
  <div class="flex items-center gap-4 min-w-0">
    <a class="-ml-2 p-2 rounded-full flex items-center justify-center text-on-surface hover:opacity-80 transition-opacity active:scale-90" href="/categorias" aria-label="Voltar">
      <span class="material-symbols-outlined">arrow_back</span>
    </a>
    <h1 class="text-headline-md text-on-surface truncate">Editar Categoria</h1>
  </div>
  <div class="icon-circle w-10 h-10 bg-surface-variant text-on-surface-variant border-2 border-surface-container-high shrink-0">
    <span class="material-symbols-outlined">person</span>
  </div>
</header>

<main class="mt-20 pb-32 px-4 md:px-margin max-w-[672px] lg:max-w-[1280px] mx-auto">
  <!-- No desktop (lg): preview à esquerda (fixa ao rolar) e formulário à direita.
       No mobile continua empilhado (preview em cima, form embaixo). -->
  <div class="lg:grid lg:grid-cols-2 lg:gap-margin lg:items-start">
    <!-- Pré-visualização ao vivo: espelha o nome, o ícone e a cor escolhidos -->
    <section class="card flex flex-col items-center justify-center py-lg mb-md lg:mb-0 lg:sticky lg:top-24">
      <div class="icon-circle w-20 h-20 bg-primary-container/20 mb-md transition-colors duration-300" id="preview-icone-fundo">
        <span class="material-symbols-outlined text-[40px] text-primary" id="preview-icone" style="font-variation-settings: 'FILL' 1;">restaurant</span>
      </div>
      <h2 class="text-headline-md text-on-surface text-center px-md" id="preview-nome">Alimentação</h2>
      <p class="text-label-md text-on-surface-variant mt-2 text-center px-md">Personalize como esta categoria aparece</p>
    </section>

    <!-- Formulário -->
    <form class="flex flex-col gap-md" id="form-categoria">
      <div class="card flex flex-col gap-lg">
        <!-- Nome -->
        <div class="flex flex-col gap-sm">
          <label class="field-label text-on-surface-variant" for="nome">Nome da Categoria</label>
          <input class="form-input" id="nome" name="nome" maxlength="50" placeholder="Ex: Alimentação" type="text">
        </div>

        <!-- Tipo: a coluna cat_tipo é obrigatória na tabela categoria -->
        <div class="flex flex-col gap-sm">
          <label class="field-label text-on-surface-variant" for="tipo">Tipo</label>
          <div class="relative">
            <select class="form-input pr-10 appearance-none" id="tipo" name="tipo">
              <option value="DESPESA">Despesa</option>
              <option value="RECEITA">Receita</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
          </div>
        </div>

        <!-- Ícone: o escolhido ganha .is-selected e vai no campo escondido -->
        <div class="flex flex-col gap-sm">
          <span class="field-label text-on-surface-variant">Ícone</span>
          <div class="grid grid-cols-5 sm:grid-cols-8 lg:grid-cols-4 xl:grid-cols-8 gap-sm" id="icones">
            <button class="icone-opcao is-selected" data-icone="restaurant" type="button" aria-label="Restaurante">
              <span class="material-symbols-outlined">restaurant</span>
            </button>
            <button class="icone-opcao" data-icone="commute" type="button" aria-label="Transporte">
              <span class="material-symbols-outlined">commute</span>
            </button>
            <button class="icone-opcao" data-icone="medical_services" type="button" aria-label="Saúde">
              <span class="material-symbols-outlined">medical_services</span>
            </button>
            <button class="icone-opcao" data-icone="shopping_cart" type="button" aria-label="Compras">
              <span class="material-symbols-outlined">shopping_cart</span>
            </button>
            <button class="icone-opcao" data-icone="home" type="button" aria-label="Casa">
              <span class="material-symbols-outlined">home</span>
            </button>
            <button class="icone-opcao" data-icone="school" type="button" aria-label="Educação">
              <span class="material-symbols-outlined">school</span>
            </button>
            <button class="icone-opcao" data-icone="fitness_center" type="button" aria-label="Academia">
              <span class="material-symbols-outlined">fitness_center</span>
            </button>
            <button class="icone-opcao" data-icone="airplane_ticket" type="button" aria-label="Viagem">
              <span class="material-symbols-outlined">airplane_ticket</span>
            </button>
          </div>
          <input type="hidden" id="icone" name="icone" value="restaurant">
        </div>

        <!-- Cor -->
        <div class="flex flex-col gap-sm">
          <span class="field-label text-on-surface-variant">Cor de Identidade</span>
          <!-- gap-sm no celular: com gap-md as 6 bolinhas não cabem numa linha só -->
          <div class="flex flex-wrap gap-sm sm:gap-md" id="cores">
            <button class="cor-opcao bg-primary is-selected" data-cor="#006c49" type="button" aria-label="Verde escuro"></button>
            <button class="cor-opcao bg-secondary" data-cor="#af8e0b" type="button" aria-label="Dourado"></button>
            <button class="cor-opcao bg-tertiary" data-cor="#a83639" type="button" aria-label="Vermelho"></button>
            <button class="cor-opcao bg-primary-container" data-cor="#10b981" type="button" aria-label="Esmeralda"></button>
            <button class="cor-opcao bg-on-secondary-container" data-cor="#745c00" type="button" aria-label="Mostarda"></button>
            <button class="cor-opcao bg-error" data-cor="#ba1a1a" type="button" aria-label="Erro"></button>
          </div>
          <input type="hidden" id="cor" name="cor" value="#006c49">
        </div>

        <!-- Limite de orçamento -->
        <div class="flex flex-col gap-md">
          <div class="flex items-center justify-between gap-sm">
            <div>
              <span class="field-label text-on-surface">Limite de Orçamento</span>
              <p class="text-label-md text-on-surface-variant">Receba alertas ao atingir o valor</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0">
              <input class="sr-only peer" id="tem-orcamento" type="checkbox" checked>
              <div class="w-11 h-6 bg-surface-container-highest rounded-full peer peer-checked:bg-primary-container after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border after:border-gray-300 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full peer-checked:after:border-white"></div>
            </label>
          </div>
          <div class="transition-opacity duration-200" id="caixa-orcamento">
            <div class="relative">
              <span class="absolute left-md top-1/2 -translate-y-1/2 text-body-md text-on-surface-variant">R$</span>
              <input class="form-input pl-12" id="orcamento" name="orcamento" placeholder="0,00" type="number" step="0.01" min="0">
            </div>
          </div>
        </div>
      </div>

      <!-- Ações -->
      <div class="flex flex-col gap-md pt-md">
        <button class="w-full bg-secondary text-on-secondary py-md rounded-xl text-label-lg shadow-lift active:scale-[0.98] transition-all" id="btn" type="button">
          Salvar Alterações
        </button>
        <button class="w-full bg-transparent text-error border border-error/30 py-md rounded-xl text-label-lg hover:bg-error-container/20 transition-all flex items-center justify-center gap-2" id="btn-excluir" type="button">
          <span class="material-symbols-outlined text-[20px]">delete</span>
          Excluir Categoria
        </button>
      </div>
    </form>
  </div>
</main>

<script>
  // ===== Pré-visualização ao vivo =====
  const previewIcone = document.getElementById('preview-icone');
  const previewFundo = document.getElementById('preview-icone-fundo');

  document.getElementById('nome').addEventListener('input', (e) => {
    document.getElementById('preview-nome').textContent = e.target.value || 'Nome da Categoria';
  });

  // ===== Escolha do ícone =====
  const botoesIcone = document.querySelectorAll('.icone-opcao');

  botoesIcone.forEach(botao => {
    botao.addEventListener('click', () => {
      botoesIcone.forEach(b => b.classList.remove('is-selected'));
      botao.classList.add('is-selected');
      previewIcone.textContent = botao.dataset.icone;
      document.getElementById('icone').value = botao.dataset.icone;
    });
  });

  // ===== Escolha da cor =====
  const botoesCor = document.querySelectorAll('.cor-opcao');

  botoesCor.forEach(botao => {
    botao.addEventListener('click', () => {
      botoesCor.forEach(b => b.classList.remove('is-selected'));
      botao.classList.add('is-selected');
      // o "33" no fim do hex é a opacidade (20%) do fundo do círculo
      previewFundo.style.backgroundColor = botao.dataset.cor + '33';
      previewIcone.style.color = botao.dataset.cor;
      document.getElementById('cor').value = botao.dataset.cor;
    });
  });

  // ===== Liga/desliga o campo de orçamento =====
  document.getElementById('tem-orcamento').addEventListener('change', (e) => {
    const caixa = document.getElementById('caixa-orcamento');
    caixa.style.opacity = e.target.checked ? '1' : '0.4';
    caixa.style.pointerEvents = e.target.checked ? 'auto' : 'none';
  });
</script>
