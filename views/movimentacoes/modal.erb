<div class="sheet-backdrop" id="mov-backdrop"></div>

<section class="bottom-sheet" id="mov-sheet" role="dialog" aria-modal="true" aria-labelledby="mov-sheet-titulo" aria-hidden="true">
  <div class="sheet-handle"></div>

  <div class="flex items-center justify-between px-md pb-sm shrink-0">
    <h3 class="text-headline-md text-on-surface" id="mov-sheet-titulo">Editar receita</h3>
    <button class="material-symbols-outlined text-on-surface-variant hover:opacity-80 transition-opacity active:scale-90 cursor-pointer" type="button" id="mov-fechar" aria-label="Fechar">close</button>
  </div>

  <form class="flex flex-col gap-gutter px-md pb-md overflow-y-auto flex-1" id="form-editar-movimentacao">
    <input type="hidden" id="mov-edit-id" name="id">

    <div class="flex flex-col gap-base">
      <label class="field-label" for="mov-edit-nome">Nome da Receita</label>
      <div class="relative">
        <span class="material-symbols-outlined input-icon">payments</span>
        <input class="input-field" id="mov-edit-nome" name="nome" maxlength="100" placeholder="Ex: Salário, Freelance..." type="text">
      </div>
    </div>

    <div class="flex flex-col gap-base">
      <label class="field-label" for="mov-edit-valor">Valor</label>
      <div class="relative">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 font-bold text-outline">R$</span>
        <input class="input-field" id="mov-edit-valor" name="valor" placeholder="0,00" type="number" step="0.01" min="0">
      </div>
    </div>

    <div class="flex flex-col gap-base">
      <label class="field-label" for="mov-edit-data">Data</label>
      <div class="relative">
        <span class="material-symbols-outlined input-icon">calendar_month</span>
        <input class="input-field" id="mov-edit-data" name="data" type="date">
      </div>
    </div>

    <div class="flex flex-col gap-base">
      <label class="field-label" for="mov-edit-conta">Conta</label>
      <div class="relative">
        <span class="material-symbols-outlined input-icon">account_balance</span>
        <select class="input-field pr-12 appearance-none" id="mov-edit-conta" name="conta">
          <option value="0">--Selecionar--</option>
          <% if !@contas.empty? %>
            <% @contas.each do |c| %>
              <option value="<%= c["con_id"] %>"> <%= c["con_nome"] %> </option>
            <% end %>
          <% else %>
            <option value="0" disabled>Nenhuma conta cadastrada</option>
          <% end %>
        </select>
        <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
      </div>
    </div>

    <div class="flex flex-col gap-base">
      <label class="field-label" for="mov-edit-categoria">Categoria</label>
      <div class="relative">
        <span class="material-symbols-outlined input-icon">category</span>
        <select class="input-field pr-12 appearance-none" id="mov-edit-categoria" name="categoria">
          <option value="0">--Selecionar--</option>
          <% if !@categorias.empty? %>
            <% @categorias.each do |c| %>
              <% if c["cat_tipo"] == "RECEITA" %>
                <option value="<%= c["cat_id"] %>"> <%= c["cat_nome"] %> </option>
              <% end %>
            <% end %>
          <% else %>
            <option value="0" disabled>Nenhuma categoria cadastrada</option>
          <% end %>
        </select>
        <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
      </div>
    </div>

    <div class="flex gap-sm pt-1 lg:justify-end">
      <button class="flex-1 lg:flex-none lg:px-10 py-4 bg-secondary text-on-secondary font-bold rounded-xl shadow-lift flex items-center justify-center gap-2" id="btn-salvar-movimentacao" type="button">
        <span class="material-symbols-outlined">save</span>
        Salvar
      </button>
      <button class="py-4 px-6 bg-tertiary text-white font-bold rounded-xl shadow-lift flex items-center justify-center gap-2" id="btn-excluir-movimentacao" type="button">
        <span class="material-symbols-outlined">delete</span>
        Excluir
      </button>
    </div>
  </form>
</section>
