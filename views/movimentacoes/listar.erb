<script src="/js/movimentacoes/modal.js"></script>
<!-- Barra superior -->
<header class="fixed top-0 left-0 w-full z-50 flex items-center px-4 md:px-margin h-16 bg-surface">
  <a class="mr-4 -ml-2 p-2 text-on-surface-variant hover:opacity-80 transition-opacity" href="/" aria-label="Voltar">
    <span class="material-symbols-outlined">arrow_back</span>
  </a>
  <h1 class="text-headline-md font-bold text-secondary flex-1">Voltar</h1>
  <div class="icon-circle w-10 h-10 bg-surface-variant text-on-surface-variant border border-outline-variant">
    <span class="material-symbols-outlined">person</span>
  </div>
</header>

<main class="mt-20 pb-32 px-4 md:px-margin max-w-[1280px] mx-auto">
  <!-- Título -->
  <div class="mb-md">
    <p class="text-label-lg text-secondary uppercase tracking-widest">Minhas Entradas e Saídas</p>
    <h2 class="text-headline-lg text-on-surface">Minhas Movimentações</h2>
  </div>
  <!-- Lista de receitas -->
  <section>
    <div class="flex justify-between items-center gap-sm mb-md">
      <h3 class="text-headline-md text-on-surface">Movimentações Recentes</h3>
    </div>

    <div class="flex flex-col gap-gutter">
      <% if !@receitas.empty? %>
        <% @receitas.each do |r| %>
          <div class="card p-4 sm:p-md shadow-lift flex items-center justify-between gap-sm cursor-pointer">
            <div class="flex items-center gap-3 sm:gap-4 min-w-0">
              <div class="icon-circle w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 text-primary shrink-0">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">payments</span>
              </div>
             <div class="min-w-0">
                <p class="text-label-lg text-on-surface truncate"> <%= r["mov_nome"] %> </p>
                <p class="text-label-md text-outline"> <%= r["mov_data"] %> </p>
              </div>
            </div>
           <div class="text-right shrink-0">
             <p class="text-body-lg font-bold sm:text-headline-md <%= r["mov_tipo"] == "RECEITA" ? "text-primary" : "text-tertiary" %> whitespace-nowrap">
              <%= r["mov_tipo"] == "RECEITA" ? "+" : "-" %> <%= moeda(r["mov_valor"]) %>
              </p>
               <span class="text-label-md text-outline gap-x-[1]"> 
                  <%= r["con_nome"] %>
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-surface-container-high text-on-surface-variant">
                     <%= r["cat_nome"] %> 
                  </span>
               </span>
            </div>
            <button
                  class="js-opcoes-movimentacao material-symbols-outlined text-on-surface-variant shrink-0 cursor-pointer hover:opacity-80 transition-opacity active:scale-90"
                  type="button"
                  aria-label="Opções da receita"
                  data-id="<%= r['mov_id'] %>"
                  data-nome="<%= r['mov_nome'] %>"
                  data-data="<%= r['mov_data'] %>"
                  data-valor="<%= r['mov_valor'].to_f %>"
                  data-conta="<%= r['con_id'] %>"
                  data-tipo="<%= r['mov_tipo'] %>"
                  data-categoria="<%= r['cat_id'] %>"
                >more_vert</button>
          </div>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center justify-center text-center gap-base py-xl px-md rounded-xl border-2 border-dashed border-outline-variant/50 bg-surface-container-low/40">
          <div class="icon-circle w-20 h-20 bg-primary-container/20 mb-sm">
            <span class="material-symbols-outlined text-primary text-[40px]">savings</span>
          </div>
          <h4 class="text-headline-md text-on-surface">Nenhuma receita por aqui ainda</h4>
          <p class="text-body-md text-on-surface-variant max-w-[360px]">
            Parece que você não lançou nenhuma entrada... Clique no botão abaixo para registrar a sua primeira receita!
          </p>
          <a class="mt-sm py-4 px-6 bg-secondary text-white text-label-lg rounded-xl flex items-center justify-center gap-2 shadow-lift active:scale-[0.98]" href="/movimentacoes/cadastrar">
            <span class="material-symbols-outlined">add_circle</span>
            Adicionar Receita
          </a>
        </div>
      <% end %>
    </div>
  </section>
</main>
<%= erb :"movimentacoes/modal", layout: false %>
<a class="fixed bottom-24 right-6 w-14 h-14 bg-secondary-container text-on-secondary-container rounded-full shadow-lg flex items-center justify-center transition-transform active:scale-90 z-40" href="/movimentacoes/cadastrar" aria-label="Adicionar Receita">
  <span class="material-symbols-outlined text-[32px]">add</span>
</a>
